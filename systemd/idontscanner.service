[Unit]
Description=idontScanner Web Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=idontscanner
Group=idontscanner
WorkingDirectory=/opt/idontScanner
EnvironmentFile=/opt/idontScanner/.env
ExecStart=/opt/idontScanner/.venv/bin/uvicorn app.main:app --host ${IDONTSCANNER_HOST} --port ${IDONTSCANNER_PORT}
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/idontScanner/data
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
