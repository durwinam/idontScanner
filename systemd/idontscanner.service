[Unit]
Description=idontScanner HTTP Diagnostic Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=idontscanner
Group=idontscanner
WorkingDirectory=/opt/idontScanner
EnvironmentFile=/opt/idontScanner/.env
Environment=PYTHONPATH=/opt/idontScanner
ExecStart=/opt/idontScanner/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8088
Restart=on-failure
TimeoutStartSec=30
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/idontScanner /var/lib/idontscanner /var/log/idontscanner

[Install]
WantedBy=multi-user.target
