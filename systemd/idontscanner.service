[Unit]
Description=idontScanner Web Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=idontscanner
Group=idontscanner
WorkingDirectory=/opt/idontScanner
EnvironmentFile=/opt/idontScanner/.env
Environment=PYTHONPATH=/opt/idontScanner
ExecStart=/opt/idontScanner/.venv/bin/python -m app.server
Restart=on-failure
TimeoutStartSec=30
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/idontScanner /var/lib/idontscanner /var/log/idontscanner
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
